rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'akashboy403@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Village Info
    match /village_info/{villageId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Panchayat Members
    match /panchayat_members/{memberId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Government Schemes
    match /govt_schemes/{schemeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Complaints
    match /complaints/{complaintId} {
      allow read: if isSignedIn() && (isAdmin() || existing().userId == request.auth.uid);
      allow create: if isSignedIn() && 
                      incoming().userId == request.auth.uid &&
                      incoming().status == 'pending' &&
                      incoming().createdAt <= request.time;
      allow update: if isSignedIn() && (
        // User can update their own pending complaint
        (existing().userId == request.auth.uid && existing().status == 'pending' && 
         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'category', 'imageUrl', 'updatedAt'])) ||
        // Admin can update status and adminResponse
        (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'adminResponse', 'updatedAt']))
      );
      allow delete: if isAdmin();
    }

    // News
    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Gallery
    match /gallery/{photoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Emergency Contacts
    match /emergency_contacts/{contactId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users
    match /users/{userId} {
      allow read: if isSignedIn() && (isAdmin() || request.auth.uid == userId);
      allow create: if isSignedIn() && request.auth.uid == userId && 
                      (!('role' in incoming()) || incoming().role == 'user');
      allow update: if isSignedIn() && (
        // User can update their own profile (not role)
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone'])) ||
        // Admin can update roles
        (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['role']))
      );
    }
  }
}
